<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SFM.Tests</AssemblyName>
    <RootNamespace>SFM.Tests</RootNamespace>
    <!-- SFM이 SelfContained+win-x64 이므로 테스트도 동일 설정으로 맞춰야 참조 가능 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SFM 프로젝트의 Core / Data / Models 레이어를 직접 참조한다.
      PublishSingleFile·SelfContained 를 테스트 빌드에서 비활성화하여 충돌 방지.
    -->
    <ProjectReference Include="..\SFM\SFM.csproj"
                      Properties="PublishSingleFile=false;SelfContained=false;PublishReadyToRun=false" />
  </ItemGroup>

</Project>
