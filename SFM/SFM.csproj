<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SFM</AssemblyName>
    <RootNamespace>SFM</RootNamespace>

    <!-- 어셈블리 메타데이터 -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>SFM - Smart File Manager</Product>
    <Company>SFM</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Description>로컬 파일 전문 검색 도구 (파일명 + 내용 인덱싱, 한국어 초성 검색 지원)</Description>

    <!-- 애플리케이션 아이콘 (프로젝트 루트 sfm.ico) -->
    <ApplicationIcon>sfm.ico</ApplicationIcon>

    <!-- 배포 설정 (win-x64, self-contained 폴더 방식) -->
    <!-- SingleFile 방식은 첫 실행 시 %TEMP% 압축 해제 지연(30초+) 발생 → 제거 -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- WinForms는 Trim 미지원 → 비활성화 -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- ReadyToRun 제거: 크기 감소 (WinForms 앱은 JIT 체감 없음) -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- PDB 심볼 배포 제외 -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite"   Version="8.0.0" />
    <PackageReference Include="Docnet.Core"               Version="2.6.0" />
    <PackageReference Include="DocumentFormat.OpenXml"  Version="3.0.2" />
  </ItemGroup>

</Project>
